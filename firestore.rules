rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', 'farmer');
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isFarmer() {
      return isSignedIn() && (userRole() == 'farmer' || userRole() == 'admin');
    }

    function isOwner(resource) {
      return isSignedIn() && resource.data.get('ownerId', '') == uid();
    }

    function isFarmerOfRecord(resource) {
      return isSignedIn() && resource.data.get('farmerId', '') == uid();
    }

    function validString(field, minLen) {
      return request.resource.data[field] is string
             && request.resource.data[field].size() >= minLen;
    }

    match /userProfile/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    match /users/{userId} {
      allow read:   if isSignedIn() && (uid() == userId || isAdmin());
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && (uid() == userId || isAdmin());
      allow delete: if isSignedIn() && (uid() == userId || isAdmin());
    }

    match /user_profiles/{userId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && uid() == userId;
    }

    match /export_listings/{listingId} {
      allow read: if isSignedIn() && (
                    isAdmin() ||
                    uid() == resource.data.farmerId ||
                    (resource.data.visibleToExporters is list &&
                     uid() in resource.data.visibleToExporters)
                  );
      allow create: if isSignedIn() && uid() == request.resource.data.farmerId;
      allow update, delete: if isSignedIn() && (uid() == resource.data.farmerId || isAdmin());
    }

    match /export_products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && uid() == request.resource.data.ownerId;
      allow update, delete: if isSignedIn() && (isOwner(resource) || isAdmin());
    }

    match /purchase_orders/{poId} {
      allow create: if isSignedIn() && uid() == request.resource.data.buyerId;
      allow read, update, delete: if isSignedIn() && (
                                    uid() == resource.data.buyerId  ||
                                    uid() == resource.data.farmerId ||
                                    isAdmin()
                                  );

      match /buyer_responses/{respId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/purchase_orders/$(poId)).data.buyerId  == uid() ||
          get(/databases/$(database)/documents/purchase_orders/$(poId)).data.farmerId == uid() ||
          isAdmin()
        );
        allow create: if isSignedIn()
                      && request.resource.data.buyerId == uid()
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0;
        allow update, delete: if isSignedIn() && (resource.data.buyerId == uid() || isAdmin());
      }
    }

    match /export_demand/{demandId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['responses']));
    }

    match /export_documents/{docId} {
      allow read, create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    match /qc_reports/{reportId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && (uid() == resource.data.inspectorId || isAdmin());
    }

    match /shipments/{shipmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /international_buyers/{buyerId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /warehouse_stock/{stockId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /warehouse_transactions/{txId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /farmers/{farmerId} {
      allow read: if true;
      allow write: if isSignedIn() && uid() == request.resource.data.ownerId;
    }

    match /farmer_listings/{listingId} {
      allow read: if true;
      allow write: if isSignedIn() && uid() == request.resource.data.ownerId;
    }

    match /rent_machines/{machineId} {
      allow read: if true;
      allow create: if isSignedIn() && uid() == request.resource.data.ownerId;
      allow update, delete: if isSignedIn() && (isOwner(resource) || isAdmin());
    }

    match /rent_bookings/{bookingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /labours/{labourId} {
      allow read: if true;
      allow create: if isSignedIn() && uid() == request.resource.data.createdBy;
      allow update, delete: if isSignedIn() && (uid() == resource.data.createdBy || isAdmin());
    }

    match /labour_profiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && uid() == profileId;
      allow delete: if isSignedIn() && (uid() == profileId || isAdmin());
    }

    match /job_posts/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() == request.resource.data.farmerId;
      allow update, delete: if isSignedIn() && (uid() == resource.data.farmerId || isAdmin());
    }

    match /job_applications/{appId} {
      allow read: if isSignedIn() && (
                    uid() == resource.data.labourId ||
                    uid() == resource.data.farmerId ||
                    isAdmin()
                  );
      allow create: if isSignedIn() && uid() == request.resource.data.labourId;
      allow update: if isSignedIn() && (
                      uid() == resource.data.farmerId ||
                      uid() == resource.data.labourId ||
                      isAdmin()
                    );
      allow delete: if isSignedIn() && (uid() == resource.data.labourId || isAdmin());
    }

    match /labour_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() == request.resource.data.reviewerId;
      allow update, delete: if isAdmin();
    }

    match /hire_requests/{reqId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /plant_vendors/{vendorId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && (uid() == request.resource.data.ownerId ||
                        uid() == request.resource.data.createdBy)
                    && (!(request.resource.data.keys().hasAny(['name'])) ||
                        validString('name', 2));
      allow update, delete: if isSignedIn() && (
                              uid() == resource.data.ownerId ||
                              uid() == resource.data.createdBy ||
                              isAdmin()
                            );
    }

    match /plant_products/{productId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isOwner(resource) || isAdmin());
    }

    match /plant_orders/{orderId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /disease_reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() && (
                      uid() == request.resource.data.reporterId ||
                      uid() == request.resource.data.userId
                    );
      allow update, delete: if isSignedIn() && (
                              uid() == resource.data.reporterId ||
                              uid() == resource.data.userId     ||
                              isAdmin()
                            );
    }

    match /disease_logs/{logId} {
      allow read, update, delete: if isSignedIn() && resource.data.get('userId', '') == uid();
      allow create: if isSignedIn();
    }

    match /locations/{locId} {
      allow create: if isSignedIn() && uid() == request.resource.data.createdBy;
      allow read, update, delete: if isSignedIn() && (uid() == resource.data.createdBy || isAdmin());
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn() && (uid() in resource.data.members || isAdmin());
      allow create: if isSignedIn()
                    && request.resource.data.members is list
                    && uid() in request.resource.data.members;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
          isAdmin()
        );
        allow create: if isSignedIn()
                      && uid() == request.resource.data.senderId
                      && validString('text', 1);
        allow update, delete: if isSignedIn() && (uid() == resource.data.senderId || isAdmin());
      }
    }

    match /notifications/{noteId} {
      allow read: if isSignedIn() && uid() == resource.data.userId;
      allow create, update, delete: if isAdmin();
    }

    match /km_notifications/{notifId} {
      allow read: if isSignedIn() && (
                    resource.data.get('userId', '') == uid() ||
                    resource.data.get('userId', '') == ''    ||
                    isAdmin()
                  );
      allow create: if isAdmin();
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && (resource.data.get('userId', '') == uid() || isAdmin());
    }

    match /admin/{doc} {
      allow read, write: if isAdmin();
    }

    match /wishlist/{userId}/items/{itemId} {
      allow read, create, delete: if isSignedIn() && uid() == userId;
      allow update: if false;
    }

    // ── GreenBazaar Cart ──────────────────────────────────────────────────────

    match /gb_cart/{userId}/items/{itemId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ── GreenBazaar Wishlist ──────────────────────────────────────────────────

    match /gb_wishlist/{userId}/items/{itemId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ── GreenBazaar Orders ────────────────────────────────────────────────────

    match /gb_orders/{orderId} {
      allow read: if isSignedIn() && (
                    resource.data.get('userId', '') == uid() ||
                    uid() in resource.data.get('sellerUids', []) ||
                    isAdmin()
                  );
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin() ||
                      (isSignedIn() &&
                       uid() in resource.data.get('sellerUids', []) &&
                       request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
