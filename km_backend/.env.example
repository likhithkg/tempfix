PORT=5000

# Public HTTPS base URL of this server (used to build profile-photo URLs returned to clients)
BACKEND_URL=https://km-backend-ug96.onrender.com

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# AI proxy keys — NEVER put these in Flutter source or pubspec.yaml
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# CORS — comma-separated list of allowed web origins for Flutter Web deployment
# Leave empty to allow all origins (development only)
# Example: ALLOWED_ORIGINS=https://yourapp.hostinger.com,https://www.yourapp.com
ALLOWED_ORIGINS=
